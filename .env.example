# Google Sheets API / Apps Script Web App URL for Courtside database sync.
# This powers the "Sync to Google Sheets" button in Settings — a one-way,
# one-click mirror of your data to a sheet, using a Google Apps Script you
# deploy yourself. See DEPLOYMENT.md for the exact script + steps.
VITE_GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbzecyND2BCUQ9m7Clmi4eurGIK5-XNb6YBs4T3FpoM6z0RyhEw7jW2vUDxmWoFaKxFy5A/exec
# ---------------------------------------------------------------------------
# Google Sheets as the app's actual database (optional — recommended).
# If all three of these are set, the app reads and writes its live data
# (events, tickets, users, orders, etc.) in this Google Sheet instead of a
# local JSON file — this is what makes data auto-save reliably and survive
# refreshes/redeploys. If any are missing, the app falls back to a local
# JSON file automatically. See DEPLOYMENT.md for full setup steps.
# ---------------------------------------------------------------------------

# GOOGLE_SHEET_ID: The ID from your Google Sheet's URL, e.g. for
# https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz/edit
# the ID is "1AbCdEfGhIjKlMnOpQrStUvWxYz".
GOOGLE_SHEET_ID=1h1QoiFHmL_NFqZm8x-_9EiuAqtjEU_ITiu18ySL902I

# GOOGLE_SERVICE_ACCOUNT_EMAIL: From your Service Account's JSON key file
# (the "client_email" field). This account must be shared on the Sheet
# above as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=courtside-ticket-syatem@courtside-liberia-tickets.iam.gserviceaccount.com

# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: From your Service Account's JSON key
# file (the "private_key" field) — paste it exactly as-is, including the
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- lines and the
# \n sequences between them.
